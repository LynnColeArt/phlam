/// Adds integer amounts, saturating the total at -16 and 16.
/// Every add writes and returns the resulting total, including at a limit.
class SaturatingAccumulator {
    $total = 0

    function init($starting_total = 0) {
        $this->total = $starting_total
    }

    function add($amount) {
        $next = $this->total + $amount
        if ($next < -16) {
            $this->total = -16
            return $this->total
        }
        if ($next > 16) {
            $this->total = 16
            return $this->total
        }
        $this->total = $next
        return $this->total
    }

    function read() {
        return $this->total
    }
}
